<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUI.Pages.SettingsPage"
             Title="Settings">

    <ContentPage.Resources>
        <Style x:Key="CategoryBanner" TargetType="Grid">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="CategoryBannerLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>
        <Style x:Key="CategoryCard" TargetType="Border">
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">
            <Border Style="{StaticResource CategoryCard}">
                <VerticalStackLayout Spacing="0">
                    <Grid Style="{StaticResource CategoryBanner}">
                        <Label Text="Type" Style="{StaticResource CategoryBannerLabel}" />
                    </Grid>
                    <VerticalStackLayout Padding="12" Spacing="8">
                        <VerticalStackLayout x:Name="TypeItemsLayout" Spacing="4" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="TypeEntry"
                                   Placeholder="Add type"
                                   Completed="OnAddTypeClicked"
                                   Grid.Column="0" />
                            <Button Text="Add"
                                    Clicked="OnAddTypeClicked"
                                    Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CategoryCard}">
                <VerticalStackLayout Spacing="0">
                    <Grid Style="{StaticResource CategoryBanner}">
                        <Label Text="Rarity" Style="{StaticResource CategoryBannerLabel}" />
                    </Grid>
                    <VerticalStackLayout Padding="12" Spacing="8">
                        <VerticalStackLayout x:Name="RarityItemsLayout" Spacing="4" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="RarityEntry"
                                   Placeholder="Add rarity"
                                   Completed="OnAddRarityClicked"
                                   Grid.Column="0" />
                            <Button Text="Add"
                                    Clicked="OnAddRarityClicked"
                                    Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CategoryCard}">
                <VerticalStackLayout Spacing="0">
                    <Grid Style="{StaticResource CategoryBanner}">
                        <Label Text="Size" Style="{StaticResource CategoryBannerLabel}" />
                    </Grid>
                    <VerticalStackLayout Padding="12" Spacing="8">
                        <VerticalStackLayout x:Name="SizeItemsLayout" Spacing="4" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="SizeEntry"
                                   Placeholder="Add size"
                                   Completed="OnAddSizeClicked"
                                   Grid.Column="0" />
                            <Button Text="Add"
                                    Clicked="OnAddSizeClicked"
                                    Grid.Column="1" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Restore defaults"
                    Clicked="OnRestoreDefaultsClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

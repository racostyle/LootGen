<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUI.Pages.ProfilesPage"
             Title="Profiles">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Profiles come from resource data folders. Tap a profile to select it." />

            <VerticalStackLayout x:Name="ProfilesLayout" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

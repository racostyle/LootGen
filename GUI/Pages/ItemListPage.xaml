<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUI.Pages.ItemListPage"
             Title="Item List">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Type" FontAttributes="Bold" />
            <FlexLayout x:Name="TypeButtonsLayout"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="Start"
                        AlignItems="Start"
                        AlignContent="Start" />

            <Label Text="Highest rarity available" FontAttributes="Bold" />
            <Picker x:Name="RarityPicker" Title="Rarity" />

            <Button x:Name="ListItemsButton"
                    Text="List Items"
                    Clicked="OnListItemsClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUI.MainPage"
             Title="LootGen">

    <VerticalStackLayout
        Padding="30"
        Spacing="16"
        VerticalOptions="Center">

        <Button
            x:Name="ProfileButton"
            Clicked="OnProfileClicked"
            HorizontalOptions="Fill" />

        <Button
            Text="Store"
            Clicked="OnLocationStoreClicked"
            HorizontalOptions="Fill" />

        <Button
            Text="Item List"
            Clicked="OnItemListClicked"
            HorizontalOptions="Fill" />

        <Button
            Text="Settings"
            Clicked="OnSettingsClicked"
            HorizontalOptions="Fill" />

        <Button
            Text="Import / Export"
            Clicked="OnImportExportClicked"
            HorizontalOptions="Fill" />

    </VerticalStackLayout>

</ContentPage>
